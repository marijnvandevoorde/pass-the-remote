# Pass the Remote — a companion app to Pass the Aux.
#
# Copy this to .env, set REMOTE_SECRET, point MUSIC_HOST_DIR (docker) or
# MUSIC_DIR (native) at a folder of audio files, and run:
#   docker compose up -d        # containerised
#   npm start                   # native (Node 24+)

# ───── Required ─────

# Shared secret. Pass the Aux sends `Authorization: Bearer <REMOTE_SECRET>`.
# Must match the secret you configure on the Pass the Aux side when
# adding this as a remote record store.
# Generate one: openssl rand -hex 32
REMOTE_SECRET=

# ───── Common ─────

# How often to re-scan the music folder (seconds). 0 disables.
SCAN_INTERVAL_S=300

# ───── Docker compose only ─────

# Host path to your music folder. Mounted read-only into the container
# at /music. Default: ./music (relative to this directory).
MUSIC_HOST_DIR=./music

# Host port to publish on. The container always listens on 3000 internally.
PORT=3000

# ───── Native (`npm start`) only ─────
# Ignored when running via docker compose.

# Where the audio files live. Subdirectories scanned recursively.
# MUSIC_DIR=./music

# SQLite index location.
# DB_PATH=./library.db

# Bind address.
# HOST=0.0.0.0
